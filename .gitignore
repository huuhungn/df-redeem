# Build output — regenerated by `node build.js`, never hand-edited.
/extension/
/dist/

# Local experiments and one-off probe dumps.
/.archive/
/analysis.json
/queue.json
/full-run.json
/panel-*.png
/screenshots/

# Anything carrying a live session or token. Nothing here may ever be committed.
*.token
*.secret
.dev.vars
.env
.env.*
!.env.example

# Node / editor noise.
node_modules/
npm-debug.log*
.DS_Store
Thumbs.db
*.swp

# Cloudflare Wrangler local state.
.wrangler/

# Editor backups of pre-v3 UI files.
src/ui/*.bak
src/ui/.*.bak

# Superseded by data/presets.json.
/community-presets.json
