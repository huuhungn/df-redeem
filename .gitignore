# Build output is COMMITTED on purpose — never hand-edit it, always regenerate
# with `node build.js`.
#
# extension/ is tracked so the unpacked extension can be loaded straight from a
# clone: `git pull` + Reload in chrome://extensions picks up a new version,
# with no download-and-reinstall cycle per release. Untracking it would mean
# every user has to rebuild before the extension works at all.
#
# dist/ is tracked for the same reason: the console/userscript/headless bundles
# are what people paste or point Tampermonkey at, so they must exist in the
# repo rather than only on the machine that ran the build.

# Local experiments and one-off probe dumps.
/.archive/
/analysis.json
/queue.json
/full-run.json
/panel-*.png
/screenshots/

# Anything carrying a live session or token. Nothing here may ever be committed.
*.token
*.secret
.dev.vars
.env
.env.*
!.env.example

# Node / editor noise.
node_modules/
npm-debug.log*
.DS_Store
Thumbs.db
*.swp

# Cloudflare Wrangler local state.
.wrangler/

# Editor backups of pre-v3 UI files.
src/ui/*.bak
src/ui/.*.bak

# Superseded by data/presets.json.
/community-presets.json
