{
  "manifest_version": 3,
  "key": "",
  "name": "Delta Force Auto Redeem",
  "short_name": "DF Redeem",
  "version": "3.3.2",
  "description": "Đổi hàng loạt giftcode Delta Force, xác minh bằng phản hồi mạng thật. Không gửi dữ liệu cá nhân ra ngoài.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mở bảng đổi code Delta Force",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://redeem.df.garena.sg/*",
    "https://raw.githubusercontent.com/huuhungn/df-redeem/*",
    "https://df-redeem-vault.huuhungn.workers.dev/*",
    "https://www.playdeltaforce.com/gun-codes/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://redeem.df.garena.sg/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://redeem.df.garena.sg/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.playdeltaforce.com/events/hq/*"
      ],
      "js": [
        "hq-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.playdeltaforce.com/events/hq/*"
      ],
      "js": [
        "hq-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png"
      ],
      "matches": [
        "https://redeem.df.garena.sg/*"
      ]
    }
  ]
}