{
  "name": "df-redeem-vault",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Independent installs that must agree before a code is published.
    // Two independent installs must agree before a public community verdict is
    // published. Per-account responses are always retained locally only.
    "CONFIRMATIONS_REQUIRED": "2"
  },
  "kv_namespaces": [
    {
      // Created with `wrangler kv namespace create VAULT`.
      // `wrangler dev --local` ignores this id and uses on-disk KV.
      "binding": "VAULT",
      "id": "7b1870e0141c4fa288808bbd02d8deae"
    }
  ]
  // IP_SALT and ADMIN_TOKEN are secrets, set with `wrangler secret put`, never here.
}
